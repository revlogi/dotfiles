# Core modules
zmodule environment
zmodule git
zmodule input
zmodule termtitle
zmodule utility

# Prompt
zmodule duration-info
zmodule git-info
zmodule asciiship

# Completion must follow all modules that add completion definitions.
zmodule zsh-users/zsh-completions --fpath src
zmodule completion

# Keep this order; autosuggestions must be last for manual widget rebinding.
zmodule zsh-users/zsh-syntax-highlighting
zmodule zsh-users/zsh-history-substring-search
zmodule zsh-users/zsh-autosuggestions

{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "margin": 2
  },
  "heading": {
    "bold": true,
    "color": "4",
    "block_suffix": "\n"
  },
  "h1": {
    "prefix": "\u258e ",
    "bold": true,
    "color": "5"
  },
  "h2": {
    "prefix": "\u25c6 ",
    "color": "4"
  },
  "h3": {
    "prefix": "\u203a ",
    "color": "6"
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "\u2502 "
  },
  "list": {
    "level_indent": 2
  },
  "item": {
    "block_prefix": "\u2022 "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "strong": {
    "bold": true
  },
  "emph": {
    "italic": true
  },
  "strikethrough": {
    "crossed_out": true
  },
  "link": {
    "color": "4",
    "underline": true
  },
  "link_text": {
    "bold": true,
    "color": "6"
  },
  "code": {
    "color": "5",
    "bold": true
  },
  "code_block": {
    "margin": 2,
    "chroma": {
      "text": {},
      "background": {},
      "keyword": {
        "bold": true
      },
      "name_builtin": {
        "bold": true
      },
      "comment": {
        "italic": true
      }
    },
    "color": "6"
  },
  "table": {
    "center_separator": "\u253c",
    "column_separator": "\u2502",
    "row_separator": "\u2500"
  },
  "hr": {
    "format": "\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n"
  },
  "task": {
    "ticked": "[\u2713] ",
    "unticked": "[ ] "
  }
}
